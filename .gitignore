# =========================
# AgentRaz — monorepo ignores
# =========================

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.*

# --- Python (backend, tests, experiments) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
backend/venv/
*.egg-info/
.eggs/
dist/
build/
*.egg

# Pytest / coverage / type checkers
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
hypothesis/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.vite/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Generated / local data ---
experiments/data/

# --- Logs & temp ---
*.log
logs/
*.tmp
*.temp
*.swp
*~

# --- IDE / editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Testing artifacts ---
coverage/
frontend/coverage/
tests/__pycache__/

# --- Optional local tooling ---
*.local
